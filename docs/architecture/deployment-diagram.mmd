flowchart TB
    student["Student browser"]
    admin["Admin browser"]
    vercel["Vercel\nReact/Vite SPA"]

    subgraph cicd["GitHub CI/CD"]
        pr["Pull request"]
        prcheck["PR validation\nclean test bootJar"]
        main["main push or manual dispatch"]
        actions["GitHub Actions\nDeploy to GCP Cloud Run"]
        oidc["OIDC Workload Identity\nshort-lived GCP credentials"]
        source["gcloud run deploy --source ."]
        smoke["Candidate smoke\nhealth, API, auth, cache metrics"]
        promote["Traffic promotion\n10% -> 50% -> 100% when configured"]
        rollback["Rollback\nprevious revision -> 100%"]
    end

    subgraph gcp["Google Cloud asia-northeast3"]
        cloudrun["Cloud Run service\n0..3 instances, concurrency 40\n1 vCPU / 1 GiB"]
        stable["Stable revision\nproduction traffic"]
        candidate["Tagged candidate revision\ninitially zero traffic"]
        secrets["Secret Manager\nDB, Gemini, admin bootstrap, Redis credentials"]
        redis["Memorystore Redis\nprivate VPC endpoint\nshared subject-cache L2"]
    end

    subgraph data["Supabase PostgreSQL"]
        appdata["Application data\nsubjects, schedules, room segments,\nusers, wishlists, timetables"]
        sharedstate["Shared runtime state\nSpring JDBC sessions, login limits,\ncache versions, import plans and locks"]
        operations["Operations data\nupdate logs, notifications, inquiries,\nFAQ, analytics, admin audit"]
        flyway["Flyway migrations\nHibernate ddl-auto=validate"]
    end

    gemini["Google Gemini API\nPDF / legacy Excel parsing"]
    metrics["Actuator / Micrometer\nhealth and Prometheus metrics"]
    localobs["Repository-local\nPrometheus + Grafana"]

    student -->|"Loads SPA"| vercel
    admin -->|"Loads SPA/admin pages"| vercel
    vercel -->|"/api/** and /admin/api/**"| cloudrun
    cloudrun --> stable
    cloudrun -.->|"candidate tag URL"| candidate

    stable --> appdata
    stable --> sharedstate
    stable --> operations
    stable --> redis
    stable --> metrics
    candidate --> appdata
    candidate --> sharedstate
    candidate --> redis
    candidate --> metrics
    secrets --> stable
    secrets --> candidate
    flyway --> appdata
    stable -->|"PDF/legacy Excel import only"| gemini

    pr --> prcheck
    main --> actions
    actions --> oidc
    oidc --> source
    source --> candidate
    candidate --> smoke
    smoke -->|"pass"| promote
    promote --> stable
    smoke -.->|"fail before traffic: stable traffic unchanged"| stable
    promote -.->|"verification fail"| rollback
    rollback --> stable

    localobs -.->|"local scrape"| metrics
